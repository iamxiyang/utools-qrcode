{
  "main": "index.html",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:5173/index.html",
    "preload": "preload.js"
  },
  "preload": "preload.js",
  "pluginSetting": {
    "single": false
  },
  "features": [
    {
      "code": "qrcode",
      "explain": "生成二维码图片、识别图片中二维码",
      "cmds": [
        "二维码",
        "QRCode",
        "扫码",
        "扫一扫",
        "截图扫码",
        "生成二维码",
        "解析二维码",
        {
          "type": "regex",
          "match": "/^https?:\\/\\/.+/i",
          "label": "生成二维码"
        },
        {
          "type": "over",
          "label": "生成二维码"
        },
        {
          "type": "img",
          "label": "识别图片中二维码"
        },
        {
          "type": "files",
          "fileType": "file",
          "match": "/\\.(png|jpe?g|bmp|gif|webp)$/i",
          "label": "识别图片中二维码",
          "minLength": 1,
          "maxLength": 1
        },
        {
          "type": "window",
          "platform": [
            "win32",
            "darwin"
          ],
          "match": {
            "app": [
              "chrome.exe",
              "firefox.exe",
              "MicrosoftEdge.exe",
              "iexplore.exe",
              "opera.exe",
              "brave.exe",
              "msedge.exe",
              "Google Chrome.app",
              "Safari.app",
              "Firefox.app",
              "Opera.app",
              "Vivaldi.app",
              "Brave Browser.app",
              "Microsoft Edge.app",
              "Arc.app"
            ]
          },
          "label": "当前网页二维码"
        }
      ]
    }
  ]
}